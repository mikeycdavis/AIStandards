flowchart TB
    subgraph govern["Governing inputs (never generated)"]
        brief["artifacts/prompts/<br/>original_prompt.md"]
        spec["artifacts/prompts/<br/>ai-standards-spec.md"]
        boundary["artifacts/<br/>boundary-review.json"]
        foreign["artifacts/foreign-<br/>namespace-inventory.json"]
    end

    subgraph gates["Review gates and corpus tooling (exit 0/1/2)"]
        fidelity["fidelity.mjs<br/>verbatim bytes"]
        inventory["inventory.mjs<br/>catalog review checks"]
        specmod["spec.mjs<br/>spec + prompt parser"]
        sections["standards-sections.mjs<br/>ten-section conformance"]
        sync["sync-rule-tables.mjs<br/>tables + coverage"]
        nstest["test/namespace.test.mjs<br/>no full-id collision"]
    end

    subgraph corpus["Normative corpus"]
        stds["standards/*.md<br/>11 of 53 written"]
        rules["rules/*.json<br/>8 shards, 46 rules"]
        schemas["schemas/*.json<br/>5 schemas"]
    end

    subgraph engine["Evaluation engine"]
        cli["standards.mjs<br/>audit · validate"]
        catalog["catalog.mjs<br/>load + invariants"]
        policy["policy.mjs<br/>target-relative resolve"]
        compliance["compliance.mjs<br/>evaluate · envelope · distinction"]
    end

    subgraph parsers["Dependency-free parsers"]
        yaml["yaml.mjs"]
        jsonschema["jsonschema.mjs"]
        source["source.mjs<br/>use/mention split"]
        scaffolding["scaffolding.mjs"]
    end

    subgraph out["Outputs"]
        auditrep["audit report<br/>evidence, no verdict"]
        valrep["validate report<br/>status + distinction[]"]
    end

    target[("Target repository<br/>+ ai-policy.yml")]

    brief -->|"byte compare"| fidelity
    spec --> specmod
    specmod --> inventory
    specmod --> sections
    boundary --> inventory
    spec -->|"claims an<br/>implementing file"| stds
    stds --> inventory
    stds -->|"headings, H1,<br/>Source line"| sections
    rules --> inventory
    foreign -->|"recorded foreign ids"| nstest
    catalog --> nstest

    rules --> catalog
    catalog --> sync
    sync -->|"rewrites generated<br/>blocks only"| stds
    schemas --> policy
    schemas --> cli
    catalog --> cli
    target -->|"file walk,<br/>512 KB cap"| cli
    target -->|"ai-policy.yml"| policy
    policy --> cli
    yaml --> policy
    yaml --> cli
    jsonschema --> policy
    source --> cli
    scaffolding --> cli
    cli --> compliance
    cli -->|"audit"| auditrep
    compliance -->|"validate"| valrep

